---
/**
 * Header.astro
 * Sticky top header: logo + always-visible hamburger + search input.
 * Hamburger opens a full-overlay modal nav on every viewport.
 * On <768px the search input becomes a magnifier icon that opens a search drawer.
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

// Load site config
const siteConfigPath = join(process.cwd(), 'content/_site.json');
interface NavGroup { label: string; id: string; blurb?: string; children: string[]; }
type NavEntry = string | NavGroup;
let siteConfig: { title?: string; navigation_order?: NavEntry[] } = { title: 'Mathematics Companion', navigation_order: [] };
if (existsSync(siteConfigPath)) {
  try { siteConfig = JSON.parse(readFileSync(siteConfigPath, 'utf8')); } catch { /* use default */ }
}

// Build nav items from navigation_order + colocated _section.json files
interface NavItem {
  slug: string;
  label: string;
  href: string;
  children: { label: string; href: string; slug: string; }[];
  groupLabel?: string;  // present when this item belongs to a navigation group
  isGroupParent?: boolean;  // true when this item IS a group (no own page; expands to its children)
  groupChildren?: NavItem[]; // populated for group parents
}
const navItems: NavItem[] = [];

const contentDir = join(process.cwd(), 'content');
import { readdirSync, statSync } from 'node:fs';

function buildSectionNavItem(slug: string): NavItem {
  let label = slug.replace(/^\d+-/, '').replace(/-/g, ' ');
  label = label.charAt(0).toUpperCase() + label.slice(1);

  let href = '/';
  if (slug === '00-welcome') {
    href = '/';
  } else if (slug === '91-mathematicians') {
    href = '/mathematicians';
  } else if (slug === '92-resources') {
    href = '/resources';
  } else if (slug === '93-theorems') {
    href = '/theorems';
  } else if (slug === '94-applications') {
    href = '/applications';
  } else if (slug === '95-definitions') {
    href = '/definitions';
  } else if (slug === '98-about') {
    href = '/about';
  } else if (slug === '99-graph') {
    href = '/graph';
  } else {
    href = `/${slug}`;
  }

  const sectionJsonPath = join(contentDir, slug, '_section.json');
  if (existsSync(sectionJsonPath)) {
    try {
      const sec = JSON.parse(readFileSync(sectionJsonPath, 'utf8'));
      if (sec.title) label = sec.title;
    } catch { /* keep derived label */ }
  }

  const children: { label: string; href: string; slug: string; }[] = [];
  const sectionPath = join(contentDir, slug);
  if (
    existsSync(sectionPath) &&
    slug !== '00-welcome' && slug !== '91-mathematicians' &&
    slug !== '92-resources' && slug !== '93-theorems' && slug !== '94-applications' &&
    slug !== '95-definitions' && slug !== '98-about'
  ) {
    try {
      const subs = readdirSync(sectionPath).sort();
      for (const sub of subs) {
        if (sub.startsWith('_')) continue;
        const subPath = join(sectionPath, sub);
        try { if (!statSync(subPath).isDirectory()) continue; } catch { continue; }
        const mdxPath = join(subPath, 'index.mdx');
        let childLabel = sub.replace(/^\d+-/, '').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
        if (existsSync(mdxPath)) {
          try {
            const txt = readFileSync(mdxPath, 'utf8');
            const m = txt.match(/^title\s*:\s*["']?(.+?)["']?\s*$/m);
            if (m) childLabel = m[1].replace(/^["']|["']$/g, '');
          } catch { /* keep derived */ }
        }
        const childHref = slug === '90-history' ? `/90-history/${sub}` : `/${slug}/${sub}`;
        children.push({ label: childLabel, href: childHref, slug: sub });
      }
    } catch { /* ignore */ }
  }

  return { slug, label, href, children };
}

for (const entry of siteConfig.navigation_order ?? []) {
  if (typeof entry === 'string') {
    navItems.push(buildSectionNavItem(entry));
  } else {
    const groupChildren: NavItem[] = entry.children.map(slug => {
      const item = buildSectionNavItem(slug);
      item.groupLabel = entry.label;
      return item;
    });
    navItems.push({
      slug: entry.id,
      label: entry.label,
      href: '#',
      children: [],
      isGroupParent: true,
      groupChildren,
    });
  }
}

// Short labels for the compact desktop chip nav
const shortLabels: Record<string, string> = {
  '00-welcome': 'Welcome',
  '01-foundations': 'Foundations',
  '02-core-mathematics': 'Core',
  '03-specialist-areas': 'Specialist',
  '04-advanced-topics': 'Advanced',
  '90-history': 'History',
  '91-mathematicians': 'Mathematicians',
  '92-resources': 'Resources',
  '93-theorems': 'Theorems',
  '94-applications': 'Applications',
  '95-definitions': 'Definitions',
  '96-lean4': 'Lean 4',
  '97-python': 'Python',
  '97-nature': 'Nature',
  '98-r': 'R',
  '98-about': 'About',
  '99-graph': 'Graph',
};

// Flatten groups for the desktop chip strip — show each child as its own chip
const flatNavItems: NavItem[] = [];
for (const item of navItems) {
  if (item.isGroupParent && item.groupChildren) {
    for (const child of item.groupChildren) flatNavItems.push(child);
  } else {
    flatNavItems.push(item);
  }
}
---

<header class="site-header" role="banner">
  <div class="header-inner">
    <!-- Hamburger button — always visible on all viewports -->
    <button
      class="hamburger-btn no-print"
      id="hamburger-btn"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="overlay-nav"
      aria-haspopup="dialog"
    >
      <span></span><span></span><span></span>
    </button>

    <!-- Logo / site title -->
    <a href="/" class="site-logo" aria-label="Home — Mathematics Companion">
      <img class="logo-mark" src="/icons/icon-64.png" width="32" height="32" alt="" aria-hidden="true" />
      <span class="logo-text">Mathematics Companion</span>
    </a>

    <!-- Desktop chip nav (slim row; supplementary to hamburger overlay) -->
    <nav class="desktop-nav no-print" aria-label="Section navigation">
      <ul role="list">
        {flatNavItems.map((item) => (
          <li>
            <a href={item.href} data-slug={item.slug}>
              {shortLabels[item.slug] ?? item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Search — desktop: text input; mobile: magnifier icon toggle -->
    <div class="search-wrapper no-print">
      <button class="search-icon-btn" id="search-icon-btn" aria-label="Open search" aria-expanded="false" aria-controls="header-search-wrapper">
        <!-- Magnifier SVG -->
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.8"/>
          <line x1="12.7" y1="12.7" x2="17" y2="17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
      <div id="header-search-wrapper" class="search-input-wrapper">
        <label for="header-search" class="sr-only">Search topics</label>
        <input
          type="search"
          id="header-search"
          placeholder="Search…"
          autocomplete="off"
          aria-label="Search topics"
          aria-autocomplete="list"
          aria-controls="search-dropdown"
          aria-expanded="false"
        />
      </div>
      <div id="search-dropdown" class="search-dropdown" role="listbox" aria-label="Search results" hidden></div>
    </div>

    <!-- Bookmark this page -->
    <button type="button" class="hdr-icon-btn bookmark-toggle no-print" id="bookmark-toggle"
      aria-pressed="false" aria-label="Bookmark this page" title="Bookmark this page">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16a.6.6 0 0 1-.9.52L12 18.1l-5.6 2.92A.6.6 0 0 1 5.5 20.5v-16a1 1 0 0 1 1-1z"/>
      </svg>
    </button>

    <!-- View saved bookmarks -->
    <a href="/bookmarks" class="hdr-icon-btn bookmarks-link no-print" id="bookmarks-link"
      aria-label="View your saved bookmarks" title="Your bookmarks">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 5.5h13M4 10h13M4 14.5h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
        <path d="M18.5 13.5h2.6a.4.4 0 0 1 .4.4v6.3a.4.4 0 0 1-.62.33L20 19.8l-1.88.73a.4.4 0 0 1-.62-.33v-6.3a.4.4 0 0 1 .4-.4z"/>
      </svg>
      <span class="hdr-badge" id="bookmark-count" hidden>0</span>
    </a>
  </div>
</header>

<!-- Full-site overlay nav (all viewports) -->
<div
  id="overlay-nav"
  class="overlay-nav no-print"
  role="dialog"
  aria-label="Site navigation"
  aria-modal="true"
  hidden
>
  <div class="overlay-backdrop" id="overlay-backdrop"></div>
  <nav class="overlay-panel" aria-label="Full site navigation">
    <div class="overlay-header">
      <span class="overlay-title">Navigation</span>
      <button class="overlay-close" id="overlay-close" aria-label="Close navigation menu">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <line x1="2" y1="2" x2="14" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="14" y1="2" x2="2" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <ul class="overlay-list" role="list">
      {navItems.map((item, idx) => {
        const childId = `overlay-children-${idx}`;
        if (item.isGroupParent && item.groupChildren) {
          return (
            <li class="overlay-item overlay-group">
              <div class="overlay-row">
                <span class="overlay-link overlay-group-label">{item.label}</span>
                <button
                  class="overlay-expand-btn"
                  aria-expanded="false"
                  aria-controls={childId}
                  aria-label={`Expand ${item.label} sections`}
                >
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <ul id={childId} class="overlay-children" hidden role="list">
                {item.groupChildren.map((sub, subIdx) => {
                  const subChildId = `overlay-grandchildren-${idx}-${subIdx}`;
                  const hasGrand = sub.children.length > 0;
                  return (
                    <li>
                      {hasGrand ? (
                        <>
                          <div class="overlay-row overlay-row-nested">
                            <a href={sub.href} class="overlay-child-link">{sub.label}</a>
                            <button
                              class="overlay-expand-btn"
                              aria-expanded="false"
                              aria-controls={subChildId}
                              aria-label={`Expand ${sub.label} pages`}
                            >
                              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                          </div>
                          <ul id={subChildId} class="overlay-grandchildren" hidden role="list">
                            {sub.children.map(grand => (
                              <li>
                                <a href={grand.href} class="overlay-grandchild-link">{grand.label}</a>
                              </li>
                            ))}
                          </ul>
                        </>
                      ) : (
                        <a href={sub.href} class="overlay-child-link">{sub.label}</a>
                      )}
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        }
        const hasChildren = item.children.length > 0;
        return (
          <li class="overlay-item">
            {hasChildren ? (
              <>
                <div class="overlay-row">
                  <a href={item.href} class="overlay-link">{item.label}</a>
                  <button
                    class="overlay-expand-btn"
                    aria-expanded="false"
                    aria-controls={childId}
                    aria-label={`Expand ${item.label} sections`}
                  >
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <ul id={childId} class="overlay-children" hidden role="list">
                  {item.children.map(child => (
                    <li>
                      <a href={child.href} class="overlay-child-link">{child.label}</a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <div class="overlay-row">
                <a href={item.href} class="overlay-link">{item.label}</a>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
</div>

<!-- Search drawer (mobile) -->
<div id="search-drawer" class="search-drawer no-print" hidden>
  <div class="search-drawer-inner">
    <label for="search-drawer-input" class="sr-only">Search topics</label>
    <input
      type="search"
      id="search-drawer-input"
      placeholder="Search topics…"
      autocomplete="off"
      aria-label="Search topics"
      aria-autocomplete="list"
      aria-controls="search-drawer-dropdown"
      aria-expanded="false"
    />
    <button class="drawer-close" id="search-drawer-close" aria-label="Close search">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <line x1="2" y1="2" x2="14" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <line x1="14" y1="2" x2="2" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
    <div id="search-drawer-dropdown" class="search-dropdown search-drawer-dropdown" role="listbox" aria-label="Search results" hidden></div>
  </div>
</div>

<!-- Search + hamburger logic (is:inline to avoid Vite null-byte issue) -->
<script is:inline>
(function() {

  // ---- Hamburger overlay ----
  var hamburgerBtn = document.getElementById('hamburger-btn');
  var overlayNav = document.getElementById('overlay-nav');
  var overlayClose = document.getElementById('overlay-close');
  var overlayBackdrop = document.getElementById('overlay-backdrop');
  var lastFocused = null;

  function getAllFocusable(root) {
    return Array.from(root.querySelectorAll(
      'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
    ));
  }

  function openOverlay() {
    if (!overlayNav || !hamburgerBtn) return;
    lastFocused = document.activeElement;
    overlayNav.hidden = false;
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    hamburgerBtn.setAttribute('aria-label', 'Close navigation menu');
    // Transform to X
    hamburgerBtn.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    // Focus first focusable element in panel
    var focusable = getAllFocusable(overlayNav);
    if (focusable.length) focusable[0].focus();
  }

  function closeOverlay() {
    if (!overlayNav || !hamburgerBtn) return;
    overlayNav.hidden = true;
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    hamburgerBtn.setAttribute('aria-label', 'Open navigation menu');
    hamburgerBtn.classList.remove('is-open');
    document.body.style.overflow = '';
    if (lastFocused) lastFocused.focus();
    lastFocused = null;
  }

  if (hamburgerBtn) hamburgerBtn.addEventListener('click', function() {
    overlayNav && overlayNav.hidden ? openOverlay() : closeOverlay();
  });

  if (overlayClose) overlayClose.addEventListener('click', closeOverlay);
  if (overlayBackdrop) overlayBackdrop.addEventListener('click', closeOverlay);

  // Esc to close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (overlayNav && !overlayNav.hidden) closeOverlay();
      if (searchDrawer && !searchDrawer.hidden) closeSearchDrawer();
    }
  });

  // Focus trap in overlay
  if (overlayNav) {
    overlayNav.addEventListener('keydown', function(e) {
      if (e.key !== 'Tab') return;
      var focusable = getAllFocusable(overlayNav);
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
  }

  // Overlay expand/collapse for child sections
  if (overlayNav) {
    overlayNav.querySelectorAll('.overlay-expand-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var targetId = btn.getAttribute('aria-controls');
        var panel = targetId ? document.getElementById(targetId) : null;
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        btn.classList.toggle('is-expanded', !expanded);
        if (panel) panel.hidden = expanded;
      });
    });
  }

  // Close overlay when a link is clicked
  if (overlayNav) {
    overlayNav.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', closeOverlay);
    });
  }

  // ---- Search (desktop) ----
  // Self-contained token search over the prebuilt index (public/api/index.json).
  // No external library, so nothing can fail to load at runtime.
  var searchData = null;
  var indexLoaded = false;

  var desktopInput = document.getElementById('header-search');
  var desktopDropdown = document.getElementById('search-dropdown');

  async function loadIndex(callback) {
    if (indexLoaded) { if (callback) callback(); return; }
    indexLoaded = true;
    try {
      var base = window.__BASE__ || '/';
      var res = await fetch(base + 'api/index.json');
      searchData = await res.json();
    } catch (err) {
      // Search unavailable — fail silently.
      searchData = null;
    }
    if (callback) callback();
  }

  function normalize(s) { return (s == null ? '' : String(s)).toLowerCase(); }

  function escapeHtml(s) {
    return (s == null ? '' : String(s))
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // Rank index records against a query. Every query token must appear somewhere;
  // matches in the title outrank tags/people, which outrank the summary.
  function searchIndex(q) {
    if (!searchData) return [];
    var tokens = normalize(q).split(/\s+/).filter(Boolean);
    if (!tokens.length) return [];
    var out = [];
    for (var i = 0; i < searchData.length; i++) {
      var it = searchData[i];
      var title = normalize(it.title);
      var section = normalize(it.section);
      var summary = normalize(it.summary);
      var tags = normalize((it.tags || []).join(' '));
      var people = normalize((it.mathematicians || []).join(' '));
      var hay = title + '  ' + tags + '  ' + people + '  ' + section + '  ' + summary;
      var ok = true, score = 0;
      for (var t = 0; t < tokens.length; t++) {
        var tok = tokens[t];
        if (hay.indexOf(tok) === -1) { ok = false; break; }
        if (title.indexOf(tok) !== -1) score += (title === tok ? 100 : (title.indexOf(tok) === 0 ? 40 : 20));
        else if (tags.indexOf(tok) !== -1 || people.indexOf(tok) !== -1) score += 12;
        else if (section.indexOf(tok) !== -1) score += 6;
        else score += 3;
      }
      if (ok) out.push({ item: it, score: score });
    }
    out.sort(function (a, b) { return b.score - a.score || a.item.title.length - b.item.title.length; });
    return out;
  }

  function renderResults(results, dropdownEl) {
    dropdownEl.innerHTML = '';
    if (!results.length) {
      dropdownEl.innerHTML = '<p class="search-empty">No results found.</p>';
      dropdownEl.hidden = false;
      return;
    }
    var ul = document.createElement('ul');
    ul.setAttribute('role', 'listbox');
    results.slice(0, 8).forEach(function(r) {
      var li = document.createElement('li');
      li.setAttribute('role', 'option');
      var kind = r.item.kind ? ' (' + escapeHtml(r.item.kind) + ')' : '';
      // titleHtml carries KaTeX-rendered math for titles that contain it;
      // otherwise fall back to the escaped plain title.
      var titleHtml = r.item.titleHtml || escapeHtml(r.item.title);
      li.innerHTML = '<a href="' + escapeHtml(r.item.url) + '">' +
        '<span class="result-title">' + titleHtml + kind + '</span>' +
        '<span class="result-section">' + escapeHtml(r.item.section) + '</span>' +
        '</a>';
      ul.appendChild(li);
    });
    dropdownEl.appendChild(ul);
    dropdownEl.hidden = false;
  }

  function performSearch(q, dropdownEl) {
    if (q.length < 2) { dropdownEl.hidden = true; return; }
    if (!searchData) { loadIndex(function () { if (searchData) renderResults(searchIndex(q), dropdownEl); }); return; }
    renderResults(searchIndex(q), dropdownEl);
  }

  if (desktopInput && desktopDropdown) {
    desktopInput.addEventListener('focus', function() { loadIndex(); });
    desktopInput.addEventListener('input', function() {
      var q = desktopInput.value.trim();
      performSearch(q, desktopDropdown);
      desktopInput.setAttribute('aria-expanded', q.length >= 2 ? 'true' : 'false');
    });
    document.addEventListener('click', function(e) {
      if (!desktopInput.contains(e.target) && !desktopDropdown.contains(e.target)) {
        desktopDropdown.hidden = true;
        desktopInput.setAttribute('aria-expanded', 'false');
      }
    });
    desktopInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        desktopDropdown.hidden = true;
        desktopInput.setAttribute('aria-expanded', 'false');
        desktopInput.blur();
      }
    });
  }

  // ---- Search icon (mobile) → search drawer ----
  var searchIconBtn = document.getElementById('search-icon-btn');
  var searchDrawer = document.getElementById('search-drawer');
  var searchDrawerClose = document.getElementById('search-drawer-close');
  var searchDrawerInput = document.getElementById('search-drawer-input');
  var searchDrawerDropdown = document.getElementById('search-drawer-dropdown');

  function openSearchDrawer() {
    if (!searchDrawer) return;
    searchDrawer.hidden = false;
    if (searchIconBtn) searchIconBtn.setAttribute('aria-expanded', 'true');
    if (searchDrawerInput) { searchDrawerInput.focus(); loadIndex(); }
  }

  function closeSearchDrawer() {
    if (!searchDrawer) return;
    searchDrawer.hidden = true;
    if (searchIconBtn) { searchIconBtn.setAttribute('aria-expanded', 'false'); searchIconBtn.focus(); }
    if (searchDrawerDropdown) searchDrawerDropdown.hidden = true;
  }

  if (searchIconBtn) searchIconBtn.addEventListener('click', openSearchDrawer);
  if (searchDrawerClose) searchDrawerClose.addEventListener('click', closeSearchDrawer);

  if (searchDrawerInput && searchDrawerDropdown) {
    searchDrawerInput.addEventListener('input', function() {
      var q = searchDrawerInput.value.trim();
      performSearch(q, searchDrawerDropdown);
    });
  }

  // ---- Mark active nav item ----
  var currentPath = window.location.pathname.replace(/\/$/, '') || '/';
  document.querySelectorAll('.desktop-nav a, .overlay-link').forEach(function(a) {
    var href = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
    if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
      a.setAttribute('aria-current', 'page');
      a.classList.add('active');
    }
  });

  // ---- Bookmarks (localStorage; folder-aware model, see /bookmarks) ----
  var BM_KEY = 'mc-bookmarks';
  // Model: { version:2, folders:[{id,name}], bookmarks:[{url,title,ts,folder}] }.
  // Older versions stored a plain array; normalize both into the object form.
  function bmNormalize(raw) {
    if (Array.isArray(raw)) {
      return { folders: [], bookmarks: raw.map(function (b) { return { url: b.url, title: b.title, ts: b.ts, folder: null }; }) };
    }
    if (raw && typeof raw === 'object' && Array.isArray(raw.bookmarks)) {
      return {
        folders: Array.isArray(raw.folders) ? raw.folders : [],
        bookmarks: raw.bookmarks.map(function (b) { return { url: b.url, title: b.title, ts: b.ts, folder: b.folder != null ? b.folder : null }; })
      };
    }
    return { folders: [], bookmarks: [] };
  }
  function readData() { try { return bmNormalize(JSON.parse(localStorage.getItem(BM_KEY) || 'null')); } catch (e) { return { folders: [], bookmarks: [] }; } }
  function writeData(d) { try { localStorage.setItem(BM_KEY, JSON.stringify({ version: 2, folders: d.folders, bookmarks: d.bookmarks })); } catch (e) {} }
  function pageTitle() {
    var t = (document.title || '').replace(/\s*[—-]\s*Mathematics Companion\s*$/, '').trim();
    return t || 'Mathematics Companion';
  }
  var toggleBtn = document.getElementById('bookmark-toggle');
  var countEl = document.getElementById('bookmark-count');
  var here = window.location.pathname;

  function refreshCount() {
    if (!countEl) return;
    var n = readData().bookmarks.length;
    countEl.textContent = n;
    countEl.hidden = n === 0;
  }
  function refreshToggle() {
    if (!toggleBtn) return;
    var saved = readData().bookmarks.some(function (b) { return b.url === here; });
    toggleBtn.setAttribute('aria-pressed', saved ? 'true' : 'false');
    toggleBtn.classList.toggle('is-saved', saved);
    toggleBtn.setAttribute('aria-label', saved ? 'Remove this bookmark' : 'Bookmark this page');
    toggleBtn.setAttribute('title', saved ? 'Remove this bookmark' : 'Bookmark this page');
  }
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function () {
      var d = readData();
      var i = d.bookmarks.findIndex(function (b) { return b.url === here; });
      if (i >= 0) { d.bookmarks.splice(i, 1); }
      else { d.bookmarks.unshift({ url: here, title: pageTitle(), ts: Date.now(), folder: null }); }
      writeData(d);
      refreshToggle(); refreshCount();
    });
  }
  // Keep in sync across tabs/pages.
  window.addEventListener('storage', function (e) { if (e.key === BM_KEY) { refreshToggle(); refreshCount(); } });
  refreshToggle(); refreshCount();

})();
</script>

