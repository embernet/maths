---
/**
 * LeftSidebar.astro
 * Desktop-only left navigation sidebar (≥1024px).
 * Renders full site hierarchy with collapsible sections.
 *
 * navigation_order entries may be:
 *   - a string slug (existing behaviour)
 *   - an object { label, id, children: [slug, ...] } that groups several
 *     sections under a shared collapsible heading.
 */
import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url?.pathname ?? '/' } = Astro.props;

// --- Build hierarchy from content/ ---
const contentDir = join(process.cwd(), 'content');
const siteConfigPath = join(contentDir, '_site.json');

interface NavGroup { label: string; id: string; blurb?: string; children: string[]; }
type NavEntry = string | NavGroup;

let siteConfig: { navigation_order?: NavEntry[] } = {};
if (existsSync(siteConfigPath)) {
  try { siteConfig = JSON.parse(readFileSync(siteConfigPath, 'utf8')); } catch { /* ignore */ }
}

const navOrder: NavEntry[] = siteConfig.navigation_order ?? [];

interface TopicLink { label: string; href: string; slug: string; }
interface SidebarSection {
  kind: 'section';
  sectionSlug: string;
  label: string;
  href: string;
  children: TopicLink[];
  countBadge?: number;
  isSpecial?: boolean;
}
interface SidebarGroup {
  kind: 'group';
  id: string;
  label: string;
  sections: SidebarSection[];
}
type SidebarEntry = SidebarSection | SidebarGroup;

function readSectionTitle(sectionSlug: string): string {
  const secPath = join(contentDir, sectionSlug, '_section.json');
  if (existsSync(secPath)) {
    try {
      const s = JSON.parse(readFileSync(secPath, 'utf8'));
      if (s.title) return s.title;
    } catch { /* ignore */ }
  }
  return sectionSlug.replace(/^\d+-/, '').replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

function readTopicTitle(mdxPath: string, folderSlug: string): string {
  if (!existsSync(mdxPath)) return folderSlug.replace(/^\d+-/, '').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  let text = '';
  try { text = readFileSync(mdxPath, 'utf8'); } catch { return folderSlug; }
  if (!text.startsWith('---')) return folderSlug;
  const end = text.indexOf('\n---', 3);
  if (end === -1) return folderSlug;
  const yaml = text.slice(3, end);
  const m = yaml.match(/^title\s*:\s*["']?(.+?)["']?\s*$/m);
  return m ? m[1].replace(/^["']|["']$/g, '') : folderSlug.replace(/^\d+-/, '').replace(/-/g, ' ');
}

// Count theorems from slug map + MDX files
let theoremCount = 0;
const theoremDir = join(contentDir, '93-theorems');
const slugMapPath = join(theoremDir, '_slug-map.json');
if (existsSync(slugMapPath)) {
  try { theoremCount = Object.keys(JSON.parse(readFileSync(slugMapPath, 'utf8'))).length; } catch { /* ignore */ }
}
if (theoremCount === 0 && existsSync(theoremDir)) {
  theoremCount = readdirSync(theoremDir).filter(f => f.endsWith('.mdx') && f !== 'index.mdx').length;
}

// Count applications
let appCount = 0;
const appDir = join(contentDir, '94-applications');
if (existsSync(appDir)) {
  appCount = readdirSync(appDir).filter(f => f.endsWith('.mdx') && f !== 'index.mdx').length;
}

// Count mathematicians
let mathCount = 0;
const mathDir = join(contentDir, '91-mathematicians');
if (existsSync(mathDir)) {
  mathCount = readdirSync(mathDir).filter(f => f.endsWith('.mdx') && f !== 'index.mdx').length;
}

function buildSection(slug: string): SidebarSection | null {
  const label = readSectionTitle(slug);

  if (slug === '00-welcome') {
    return { kind: 'section', sectionSlug: slug, label: 'Welcome', href: '/', children: [] };
  }

  if (slug === '91-mathematicians') {
    return {
      kind: 'section',
      sectionSlug: slug,
      label: 'Mathematicians',
      href: '/mathematicians',
      children: [],
      countBadge: mathCount,
      isSpecial: true,
    };
  }

  if (slug === '92-resources') {
    return { kind: 'section', sectionSlug: slug, label: 'Resources', href: '/resources', children: [] };
  }

  if (slug === '93-theorems') {
    return {
      kind: 'section',
      sectionSlug: slug,
      label: 'Theorems',
      href: '/theorems',
      children: [],
      countBadge: theoremCount,
      isSpecial: true,
    };
  }

  if (slug === '94-applications') {
    return {
      kind: 'section',
      sectionSlug: slug,
      label: 'Real-world applications',
      href: '/applications',
      children: [],
      countBadge: appCount || undefined,
      isSpecial: true,
    };
  }

  if (slug === '95-definitions') {
    let defCount = 0;
    try {
      const dir = join(contentDir, '95-definitions');
      if (existsSync(dir)) {
        defCount = readdirSync(dir).filter(f => f.endsWith('.mdx') && !f.startsWith('_')).length;
      }
    } catch { /* ignore */ }
    return {
      kind: 'section',
      sectionSlug: slug,
      label: 'Definitions',
      href: '/definitions',
      children: [],
      countBadge: defCount || undefined,
      isSpecial: true,
    };
  }

  if (slug === '98-about') {
    return { kind: 'section', sectionSlug: slug, label: 'About', href: '/about', children: [] };
  }

  if (slug === '99-graph') {
    return { kind: 'section', sectionSlug: slug, label: 'Connection Explorer', href: '/graph', children: [] };
  }

  // Generic section with topic children (year sections, programming sub-sections, history, nature, etc.)
  const sectionPath = join(contentDir, slug);
  const children: TopicLink[] = [];

  if (existsSync(sectionPath)) {
    let topics: string[] = [];
    try { topics = readdirSync(sectionPath).sort(); } catch { /* ignore */ }
    for (const sub of topics) {
      if (sub.startsWith('_')) continue;
      const subPath = join(sectionPath, sub);
      try {
        if (!statSync(subPath).isDirectory()) continue;
      } catch { continue; }
      const mdxPath = join(subPath, 'index.mdx');
      const childLabel = readTopicTitle(mdxPath, sub);
      const childHref = slug === '90-history' ? `/90-history/${sub}` : `/${slug}/${sub}`;
      children.push({ label: childLabel, href: childHref, slug: sub });
    }
  }

  const href = slug === '90-history' ? `/90-history` : `/${slug}`;
  return { kind: 'section', sectionSlug: slug, label, href, children };
}

const entries: SidebarEntry[] = [];
for (const item of navOrder) {
  if (typeof item === 'string') {
    const sec = buildSection(item);
    if (sec) entries.push(sec);
  } else {
    const groupSections: SidebarSection[] = [];
    for (const slug of item.children) {
      const sec = buildSection(slug);
      if (sec) groupSections.push(sec);
    }
    entries.push({ kind: 'group', id: item.id, label: item.label, sections: groupSections });
  }
}

function isCurrentSection(sec: SidebarSection): boolean {
  if (sec.href === '/' && currentPath === '/') return true;
  if (sec.href !== '/' && currentPath.startsWith(sec.href)) return true;
  if (currentPath.startsWith(`/${sec.sectionSlug}`)) return true;
  return false;
}

function isCurrentChild(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}

function isCurrentGroup(g: SidebarGroup): boolean {
  return g.sections.some(isCurrentSection);
}
---

<aside class="left-sidebar no-print" aria-label="Site navigation">
  <nav>
    {entries.map((entry, idx) => {
      if (entry.kind === 'group') {
        const groupActive = isCurrentGroup(entry);
        const groupId = `sidebar-group-${idx}`;
        return (
          <div class={`sidebar-group${groupActive ? ' is-active' : ''}`} data-active={groupActive ? 'true' : 'false'}>
            <button
              class="group-header group-toggle"
              aria-expanded={groupActive ? 'true' : 'false'}
              aria-controls={groupId}
              data-group-id={groupId}
            >
              <span class="group-label">{entry.label}</span>
              <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div id={groupId} class="group-children" hidden={!groupActive}>
              {entry.sections.map((sec, sidx) => {
                const active = isCurrentSection(sec);
                const hasChildren = sec.children.length > 0;
                const sectionId = `sidebar-sec-${idx}-${sidx}`;
                return (
                  <div class={`sidebar-section nested-section${active ? ' is-active' : ''}`} data-active={active ? 'true' : 'false'}>
                    {hasChildren ? (
                      <button
                        class="sec-header sec-toggle"
                        aria-expanded={active ? 'true' : 'false'}
                        aria-controls={sectionId}
                        data-section-id={sectionId}
                      >
                        <span class="sec-label">
                          <a href={sec.href} class="sec-link" tabindex="-1">{sec.label}</a>
                        </span>
                        {sec.countBadge !== undefined && (
                          <span class="count-badge">{sec.countBadge}</span>
                        )}
                        <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    ) : (
                      <div class="sec-header sec-plain">
                        <a href={sec.href} class={`sec-link${active ? ' active' : ''}`} aria-current={active ? 'page' : undefined}>
                          {sec.label}
                        </a>
                        {sec.countBadge !== undefined && (
                          <span class="count-badge">{sec.countBadge}</span>
                        )}
                      </div>
                    )}
                    {hasChildren && (
                      <ul id={sectionId} class="sec-children" role="list" hidden={!active}>
                        {sec.children.map((child) => {
                          const childActive = isCurrentChild(child.href);
                          return (
                            <li>
                              <a
                                href={child.href}
                                class={`child-link${childActive ? ' active' : ''}`}
                                aria-current={childActive ? 'page' : undefined}
                              >
                                {child.label}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        );
      }

      // Plain section (existing behaviour)
      const sec = entry;
      const active = isCurrentSection(sec);
      const hasChildren = sec.children.length > 0;
      const sectionId = `sidebar-sec-${idx}`;
      return (
        <div class={`sidebar-section${active ? ' is-active' : ''}`} data-active={active ? 'true' : 'false'}>
          {hasChildren ? (
            <button
              class="sec-header sec-toggle"
              aria-expanded={active ? 'true' : 'false'}
              aria-controls={sectionId}
              data-section-id={sectionId}
            >
              <span class="sec-label">
                <a href={sec.href} class="sec-link" tabindex="-1">{sec.label}</a>
              </span>
              {sec.countBadge !== undefined && (
                <span class="count-badge">{sec.countBadge}</span>
              )}
              <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          ) : (
            <div class="sec-header sec-plain">
              <a href={sec.href} class={`sec-link${active ? ' active' : ''}`} aria-current={active ? 'page' : undefined}>
                {sec.label}
              </a>
              {sec.countBadge !== undefined && (
                <span class="count-badge">{sec.countBadge}</span>
              )}
            </div>
          )}
          {hasChildren && (
            <ul id={sectionId} class="sec-children" role="list" hidden={!active}>
              {sec.children.map((child) => {
                const childActive = isCurrentChild(child.href);
                return (
                  <li>
                    <a
                      href={child.href}
                      class={`child-link${childActive ? ' active' : ''}`}
                      aria-current={childActive ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      );
    })}
  </nav>
</aside>
<div
  class="sidebar-resizer no-print"
  role="separator"
  aria-orientation="vertical"
  aria-label="Resize navigation sidebar"
  tabindex="0"
  title="Drag to resize · double-click to reset"
></div>

<script is:inline>
(function() {
  var sidebar = document.querySelector('.left-sidebar');
  if (!sidebar) return;

  function toggle(btn, panelAttr) {
    var expanded = btn.getAttribute('aria-expanded') === 'true';
    var panelId = btn.getAttribute(panelAttr);
    var panel = panelId ? document.getElementById(panelId) : null;
    if (expanded) {
      btn.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    } else {
      btn.setAttribute('aria-expanded', 'true');
      if (panel) panel.hidden = false;
    }
  }

  sidebar.querySelectorAll('.sec-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      if (e.target && e.target.tagName === 'A') return;
      e.preventDefault();
      toggle(btn, 'data-section-id');
    });
  });

  sidebar.querySelectorAll('.group-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      if (e.target && e.target.tagName === 'A') return;
      e.preventDefault();
      toggle(btn, 'data-group-id');
    });
  });

  // ---- Resizable width (persisted) ----
  var root = document.documentElement;
  var resizer = document.querySelector('.sidebar-resizer');
  var MIN = 160, MAX = 480, DEFAULT = 220, KEY = 'mc-sidebar-width';

  function applyWidth(px) {
    var w = Math.max(MIN, Math.min(MAX, Math.round(px)));
    root.style.setProperty('--sidebar-w', w + 'px');
    return w;
  }
  function currentWidth() {
    return parseInt(root.style.getPropertyValue('--sidebar-w'), 10) || DEFAULT;
  }
  function persist() {
    try { localStorage.setItem(KEY, String(currentWidth())); } catch (e) {}
  }
  try {
    var saved = parseInt(localStorage.getItem(KEY) || '', 10);
    if (saved) applyWidth(saved);
  } catch (e) {}

  if (resizer) {
    var dragging = false;
    function move(clientX) { applyWidth(clientX - sidebar.getBoundingClientRect().left); }
    function start(e) {
      dragging = true;
      resizer.classList.add('dragging');
      document.body.style.userSelect = 'none';
      document.body.style.cursor = 'col-resize';
      if (e.cancelable) e.preventDefault();
    }
    function end() {
      if (!dragging) return;
      dragging = false;
      resizer.classList.remove('dragging');
      document.body.style.userSelect = '';
      document.body.style.cursor = '';
      persist();
    }
    resizer.addEventListener('mousedown', start);
    document.addEventListener('mousemove', function(e) { if (dragging) move(e.clientX); });
    document.addEventListener('mouseup', end);
    resizer.addEventListener('touchstart', start, { passive: false });
    document.addEventListener('touchmove', function(e) { if (dragging && e.touches[0]) move(e.touches[0].clientX); }, { passive: false });
    document.addEventListener('touchend', end);
    resizer.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') applyWidth(currentWidth() - 16);
      else if (e.key === 'ArrowRight') applyWidth(currentWidth() + 16);
      else return;
      e.preventDefault();
      persist();
    });
    resizer.addEventListener('dblclick', function() {
      applyWidth(DEFAULT);
      try { localStorage.removeItem(KEY); } catch (e) {}
    });
  }
})();
</script>

<style>
  .left-sidebar {
    width: var(--sidebar-w, 220px);
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    height: calc(100vh - var(--header-h) - 2rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    padding: 1rem 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-bg);
    display: none;
  }

  @media (min-width: 1024px) {
    .left-sidebar { display: block; }
  }

  /* Drag handle to resize the sidebar (desktop only) */
  .sidebar-resizer { display: none; }
  @media (min-width: 1024px) {
    .sidebar-resizer {
      display: block;
      flex: 0 0 auto;
      width: 8px;
      margin: 0 -3px;           /* overlap the border for a comfortable grab target */
      cursor: col-resize;
      position: sticky;
      top: calc(var(--header-h) + 1rem);
      height: calc(100vh - var(--header-h) - 2rem);
      z-index: 6;
      background: transparent;
      transition: background 0.12s ease;
    }
    .sidebar-resizer::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0; bottom: 0;
      width: 2px;
      transform: translateX(-50%);
      background: transparent;
    }
    .sidebar-resizer:hover::before,
    .sidebar-resizer.dragging::before { background: var(--color-accent); }
    .sidebar-resizer:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  }

  .left-sidebar::-webkit-scrollbar { width: 4px; }
  .left-sidebar::-webkit-scrollbar-track { background: transparent; }
  .left-sidebar::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 2px; }

  .sidebar-section {
    border-bottom: 1px solid var(--color-border);
  }
  .nested-section {
    border-bottom: none;
    border-top: 1px solid var(--color-border);
  }
  .nested-section:first-child {
    border-top: none;
  }

  .sidebar-group {
    border-bottom: 1px solid var(--color-border);
  }

  .group-header {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.55rem 0.75rem 0.55rem 1rem;
    gap: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.12s;
  }
  .group-header:hover { background: var(--color-surface); }
  .group-header[aria-expanded="true"] .chevron { transform: rotate(180deg); }

  .group-label { flex: 1 1 0; min-width: 0; }

  .sidebar-group.is-active > .group-header {
    color: var(--color-accent);
  }

  .group-children {
    padding-left: 0.5rem;
    background: rgba(0, 0, 0, 0.015);
  }

  .sec-header {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    gap: 0.4rem;
  }

  .nested-section .sec-header {
    padding-left: 1.25rem;
  }

  .sec-toggle {
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: background 0.12s;
  }
  .sec-toggle:hover { background: var(--color-surface); }

  .is-active > .sec-toggle {
    color: var(--color-accent);
  }

  .sec-plain { }

  .sec-label {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sec-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    display: block;
    flex: 1 1 0;
  }
  .sec-link:hover { color: var(--color-accent); }
  .sec-link.active, .is-active .sec-link { color: var(--color-accent); }

  .sec-plain .sec-link {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .count-badge {
    flex-shrink: 0;
    display: inline-block;
    min-width: 1.4rem;
    padding: 0.05rem 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    font-size: 0.7rem;
    text-align: center;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .chevron {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform 0.2s;
  }
  .sec-toggle[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .sec-children {
    list-style: none;
    margin: 0;
    padding: 0 0 0.4rem 0;
  }

  .child-link {
    display: block;
    padding: 0.3rem 0.75rem 0.3rem 1.75rem;
    font-size: 0.78rem;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.4;
    border-radius: 0;
    transition: background 0.1s, color 0.1s;
  }
  .nested-section .child-link {
    padding-left: 2rem;
  }
  .child-link:hover {
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .child-link.active {
    color: var(--color-accent);
    font-weight: 600;
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(1.75rem - 2px);
  }
  .nested-section .child-link.active {
    padding-left: calc(2rem - 2px);
  }
</style>
