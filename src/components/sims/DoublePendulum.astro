---
/**
 * DoublePendulum.astro — a chaotic double pendulum (no deps).
 * Deterministic yet unpredictable: release a near-identical "twin" to see
 * sensitive dependence on initial conditions. Switch RK4 ↔ Euler to see why
 * the integration method matters (Euler visibly pumps in energy).
 */
import '../../styles/sims.css';
import SimRuntime from './SimRuntime.astro';
---
<SimRuntime />
<figure class="sim" data-sim="double-pendulum">
  <figcaption class="sim-caption">
    A double pendulum. The motion is completely determined by the laws of physics — yet impossible to predict for long. Release a near-identical twin to see why.
  </figcaption>
  <div class="sim-stage">
    <canvas id="dp-canvas" role="img"
      aria-label="A double pendulum swinging chaotically, with a fading trace of the lower bob">A double pendulum swinging under gravity; this interactive needs JavaScript.</canvas>
  </div>
  <div class="sim-controls">
    <button type="button" id="dp-toggle" class="sim-btn sim-btn-primary">Play</button>
    <button type="button" id="dp-twin" class="sim-btn">Release a twin</button>
    <button type="button" id="dp-method" class="sim-btn" aria-label="Integration method">Method: RK4</button>
    <button type="button" id="dp-reset" class="sim-btn">Reset</button>
    <label class="sim-slider">Gravity
      <input type="range" id="dp-grav" min="0.1" max="2" step="0.05" value="1" />
    </label>
  </div>
  <p class="sim-hint">Drag <strong>Gravity</strong> to change the pull; <strong>Reset</strong> to start over. Switch <strong>Method</strong> to crude Euler steps and watch the pendulum wrongly gain energy and fling itself around — a vivid lesson in why the integration method matters.</p>
</figure>

<script is:inline>
(function () {
  var fig = document.querySelector('[data-sim="double-pendulum"]');
  if (!fig) return;
  var canvas = fig.querySelector('#dp-canvas');
  var W = 420, H = 380;
  var ctx = window.mcSim.setupCanvas(canvas, W, H);

  // Physics in SI units (rods of 1 m, g in m/s^2, time in real seconds);
  // SCALE converts metres to pixels only when drawing. Angles are measured
  // from the downward vertical. Equations are the standard double-pendulum
  // equations of motion, validated by energy conservation (|dE/E| ~ 1e-13
  // over 20 s at h = 1e-4).
  var OX = W / 2, OY = H * 0.34, L1 = 1, L2 = 1, m1 = 1, m2 = 1, SCALE = 84;
  var DT = 0.015;              // fixed physics step (s): RK4 drifts <0.5%/min; Euler visibly blows up in ~7 s
  var MAX_STEPS = 12;          // per-frame cap so a sleeping tab doesn't spiral
  var gravEl = fig.querySelector('#dp-grav');
  var methodBtn = fig.querySelector('#dp-method');
  var reduce = window.mcSim.reducedMotion();

  var running = false, raf = null, twin = null, trace = [], useRK4 = true;
  var lastT = 0, acc = 0;
  function startState() { return [Math.PI / 2 + 0.6, 0, Math.PI / 2 + 0.1, 0]; }
  var s = startState();

  function deriv(st, g) {
    var t1 = st[0], w1 = st[1], t2 = st[2], w2 = st[3];
    var d = t1 - t2, den = 2 * m1 + m2 - m2 * Math.cos(2 * t1 - 2 * t2);
    var a1 = (-g * (2 * m1 + m2) * Math.sin(t1) - m2 * g * Math.sin(t1 - 2 * t2)
      - 2 * Math.sin(d) * m2 * (w2 * w2 * L2 + w1 * w1 * L1 * Math.cos(d))) / (L1 * den);
    var a2 = (2 * Math.sin(d) * (w1 * w1 * L1 * (m1 + m2) + g * (m1 + m2) * Math.cos(t1)
      + w2 * w2 * L2 * m2 * Math.cos(d))) / (L2 * den);
    return [w1, a1, w2, a2];
  }
  function add(a, b, f) { return [a[0] + b[0] * f, a[1] + b[1] * f, a[2] + b[2] * f, a[3] + b[3] * f]; }
  function stepOnce(st, g, h) {
    if (!useRK4) return add(st, deriv(st, g), h); // crude forward Euler
    var k1 = deriv(st, g), k2 = deriv(add(st, k1, h / 2), g),
        k3 = deriv(add(st, k2, h / 2), g), k4 = deriv(add(st, k3, h), g);
    return [st[0] + h / 6 * (k1[0] + 2 * k2[0] + 2 * k3[0] + k4[0]),
            st[1] + h / 6 * (k1[1] + 2 * k2[1] + 2 * k3[1] + k4[1]),
            st[2] + h / 6 * (k1[2] + 2 * k2[2] + 2 * k3[2] + k4[2]),
            st[3] + h / 6 * (k1[3] + 2 * k2[3] + 2 * k3[3] + k4[3])];
  }
  function pts(st) {
    var x1 = OX + SCALE * L1 * Math.sin(st[0]), y1 = OY + SCALE * L1 * Math.cos(st[0]);
    return { x1: x1, y1: y1, x2: x1 + SCALE * L2 * Math.sin(st[2]), y2: y1 + SCALE * L2 * Math.cos(st[2]) };
  }
  function colors() {
    return window.mcSim.colors(fig, {
      rod: ['--color-primary', '#1a3a52'],
      bob: ['--color-accent', '#a77b3f'],
      twin: ['--color-muted', '#999'],
      bg: ['--color-surface', '#f3f1ec']
    });
  }
  function drawArm(p, rodC, bobC) {
    ctx.strokeStyle = rodC; ctx.lineWidth = 3; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(OX, OY); ctx.lineTo(p.x1, p.y1); ctx.lineTo(p.x2, p.y2); ctx.stroke();
    ctx.fillStyle = bobC;
    ctx.beginPath(); ctx.arc(p.x1, p.y1, 5, 0, 2 * Math.PI); ctx.fill();
    ctx.beginPath(); ctx.arc(p.x2, p.y2, 7, 0, 2 * Math.PI); ctx.fill();
  }
  function render() {
    var c = colors();
    ctx.fillStyle = c.bg; ctx.fillRect(0, 0, W, H);
    if (!reduce) {
      for (var i = 1; i < trace.length; i++) {
        ctx.strokeStyle = c.bob; ctx.globalAlpha = i / trace.length * 0.5; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(trace[i - 1][0], trace[i - 1][1]); ctx.lineTo(trace[i][0], trace[i][1]); ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }
    if (twin) drawArm(pts(twin), c.twin, c.twin);
    drawArm(pts(s), c.rod, c.bob);
  }
  function tick(now) {
    if (!running) return;
    // Real-time pacing: advance physics by elapsed wall-clock time in fixed
    // DT steps (frame-rate independent; clamped so a slept tab doesn't spiral).
    if (!lastT) lastT = now;
    acc += Math.min((now - lastT) / 1000, 0.1);
    lastT = now;
    var g = (parseFloat(gravEl.value) || 1) * 9.81;
    var steps = 0;
    while (acc >= DT && steps < MAX_STEPS) {
      s = stepOnce(s, g, DT);
      if (twin) twin = stepOnce(twin, g, DT);
      acc -= DT; steps++;
      var p = pts(s); trace.push([p.x2, p.y2]); if (trace.length > 260) trace.shift();
    }
    if (steps === MAX_STEPS) acc = 0;
    render();
    raf = requestAnimationFrame(tick);
  }
  function setRunning(on) {
    running = on;
    fig.querySelector('#dp-toggle').textContent = on ? 'Pause' : 'Play';
    fig.querySelector('#dp-toggle').classList.toggle('is-running', on);
    if (on) { lastT = 0; acc = 0; raf = requestAnimationFrame(tick); }
    else if (raf) cancelAnimationFrame(raf);
  }
  function reset() { setRunning(false); s = startState(); twin = null; trace = []; render(); }
  fig.querySelector('#dp-toggle').addEventListener('click', function () { setRunning(!running); });
  fig.querySelector('#dp-reset').addEventListener('click', reset);
  fig.querySelector('#dp-twin').addEventListener('click', function () {
    twin = [s[0] + 0.001, s[1], s[2], s[3]];
    if (!running) setRunning(true);
  });
  methodBtn.addEventListener('click', function () {
    useRK4 = !useRK4;
    methodBtn.textContent = 'Method: ' + (useRK4 ? 'RK4' : 'Euler');
  });
  render();
})();
</script>
