---
/**
 * /graph — Connection Explorer.
 *
 * A simple, dependency-free way to explore how ideas connect. Two views:
 *  - Overview: every topic, grouped by section — the map of the subject.
 *  - Focus: one node centred with its direct connections arranged around it,
 *    grouped by relationship; click any connection to walk the graph.
 *
 * Design notes (why not the old hairball): of the 1,100+ graph.json nodes only
 * ~300 have any edges — a global force layout buried them in disconnected
 * dust. A local ego view shows a readable number of nodes, answers "what is
 * this connected to?", and needs no physics and no external library (the old
 * page pulled Cytoscape from a CDN, breaking the self-contained/offline rule).
 * State lives in location.hash (#<nodeId>) so views are shareable and the
 * browser back button works. The side panel mirrors the picture as a grouped
 * text list — the accessible path.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Connection Explorer" description="Explore how the ideas of mathematics connect — topics, theorems, mathematicians and applications, one step at a time.">
  <div class="graph-page">
    <header class="gx-header">
      <h1>Connection Explorer</h1>
      <p class="gx-lede">Pick any idea and see everything it touches — the theorems inside it, the people behind it, where it is used. Click a connection to keep exploring; your browser's back button retraces your steps.</p>
    </header>

    <div class="gx-toolbar no-print">
      <button type="button" id="gx-overview" class="gx-btn">Overview</button>
      <button type="button" id="gx-back" class="gx-btn" hidden>&larr; Back</button>
      <div class="gx-searchwrap">
        <label for="gx-search" class="sr-only">Search for a topic, theorem, mathematician or application</label>
        <input type="search" id="gx-search" placeholder="Jump to… e.g. Fourier, Gauss, cryptography" autocomplete="off"
          aria-label="Search for a node" aria-expanded="false" aria-controls="gx-search-list" />
        <ul id="gx-search-list" class="gx-search-list" role="listbox" hidden></ul>
      </div>
      <ul id="gx-rel-legend" class="gx-rel-legend" aria-label="Line colours in this view"></ul>
    </div>

    <div class="gx-stage-wrap">
      <div class="gx-stage" id="gx-stage" aria-live="polite">
        <p class="gx-loading" id="gx-loading">Loading the map&hellip;</p>
      </div>
      <aside class="gx-panel" id="gx-panel" aria-label="Selected idea and its connections"></aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
(function () {
  var stage = document.getElementById('gx-stage');
  var panel = document.getElementById('gx-panel');
  var loading = document.getElementById('gx-loading');
  var backBtn = document.getElementById('gx-back');
  var overviewBtn = document.getElementById('gx-overview');
  var searchInput = document.getElementById('gx-search');
  var searchList = document.getElementById('gx-search-list');
  var relLegend = document.getElementById('gx-rel-legend');
  if (!stage) return;
  var esc = window.mcUtil.escapeHtml;
  var SVGNS = 'http://www.w3.org/2000/svg';

  var NODE_COLOURS = {
    topic: '#1a3a52', theorem: '#a77b3f', application: '#5a7a3f',
    mathematician: '#6a3a5e', history: '#a7553f', definition: '#5a6a7a', nature: '#3f8a5a'
  };
  var TYPE_LABELS = {
    topic: 'Topic', theorem: 'Theorem', application: 'Application',
    mathematician: 'Mathematician', history: 'Era', definition: 'Definition', nature: 'Nature'
  };
  var REL_COLOURS = {
    'related': '#9aa5b1', 'pre-reading': '#8862b5', 'appears-in': '#c9972f',
    'attributed-to': '#b05f93', 'applies-to': '#5a9a4f', 'uses-theorem': '#d07f4f', 'uses-topic': '#4f93d0'
  };
  // [label when the centre is the edge's source, label when it is the target]
  var REL_LABELS = {
    'related': ['Related', 'Related'],
    'pre-reading': ['Suggested pre-reading', 'Prepares you for'],
    'appears-in': ['Key theorems & results', 'Appears in'],
    'attributed-to': ['Attributed to', 'Their work'],
    'applies-to': ['Real-world applications', 'Draws on'],
    'uses-theorem': ['Uses theorems', 'Used in'],
    'uses-topic': ['Draws on', 'Used in']
  };
  var SECTION_TITLES = {
    '01-foundations': 'Foundations', '02-core-mathematics': 'Core Mathematics',
    '03-specialist-areas': 'Specialist Areas', '04-advanced-topics': 'Advanced Topics',
    '97-simulation': 'Simulation', '97-nature': 'Nature', '90-history': 'History'
  };
  var SECTION_ORDER = ['01-foundations', '02-core-mathematics', '03-specialist-areas', '04-advanced-topics', '97-simulation', '97-nature', '90-history'];

  var nodesById = {};   // id -> node
  var adj = {};         // id -> [{id, type, centerIsSource}]
  var connected = [];   // nodes with >= 1 edge (what we search/explore)
  var topics = [];      // topic nodes for the overview

  function plainLabel(s) {
    return String(s == null ? '' : s).replace(/\$([^$]*)\$/g, '$1').replace(/\\[a-zA-Z]+/g, '').replace(/[{}]/g, '');
  }
  function sectionOf(node) {
    var u = node.url || '';
    var m = u.match(/^\/(?:maths\/)?(\d{2}-[a-z-]+|9\d-[a-z-]+)\//);
    return m ? m[1] : null;
  }

  // ── Views ──────────────────────────────────────────────────────────────────
  function setLegend(relTypes) {
    relLegend.innerHTML = relTypes.map(function (t) {
      return '<li><span class="gx-swatch" style="background:' + REL_COLOURS[t] + '"></span>' + esc(REL_LABELS[t][0].replace('Key theorems & results', 'Appears in / contains')) + '</li>';
    }).join('');
  }

  function showOverview() {
    backBtn.hidden = true;
    setLegend([]);
    var groups = {};
    topics.forEach(function (n) {
      var sec = sectionOf(n) || 'other';
      (groups[sec] = groups[sec] || []).push(n);
    });
    var html = '<div class="gx-overview"><p class="gx-ov-hint">The map of the subject — every topic, by section. Pick one to see its connections.</p>';
    SECTION_ORDER.concat(Object.keys(groups).filter(function (s) { return SECTION_ORDER.indexOf(s) === -1; })).forEach(function (sec) {
      var list = groups[sec];
      if (!list || !list.length) return;
      html += '<section class="gx-ov-group"><h2>' + esc(SECTION_TITLES[sec] || sec) + '</h2><ul>';
      list.forEach(function (n) {
        html += '<li><button type="button" class="gx-chip" data-id="' + esc(n.id) + '">' + esc(plainLabel(n.label)) + '</button></li>';
      });
      html += '</ul></section>';
    });
    html += '</div>';
    stage.innerHTML = html;

    panel.innerHTML = '<h2 class="gx-panel-title">Start somewhere interesting</h2><p class="gx-panel-sub">A few well-connected ideas:</p><ul class="gx-conn-list">' +
      connected.slice().sort(function (a, b) { return (adj[b.id] || []).length - (adj[a.id] || []).length; }).slice(0, 8)
        .map(function (n) {
          return '<li><button type="button" class="gx-conn" data-id="' + esc(n.id) + '"><span class="gx-dot" style="background:' + (NODE_COLOURS[n.node_type] || '#888') + '"></span>' + esc(plainLabel(n.label)) + ' <span class="gx-degree">' + (adj[n.id] || []).length + ' connections</span></button></li>';
        }).join('') + '</ul>';
  }

  function showFocus(id) {
    var node = nodesById[id];
    if (!node) { showOverview(); return; }
    backBtn.hidden = false;

    var neighbours = (adj[id] || []).map(function (e) {
      return { node: nodesById[e.id], type: e.type, centerIsSource: e.centerIsSource };
    }).filter(function (e) { return e.node; });

    // Group by relationship label for the panel + sort for the ring.
    var relOrder = ['pre-reading', 'related', 'appears-in', 'applies-to', 'uses-theorem', 'uses-topic', 'attributed-to'];
    neighbours.sort(function (a, b) {
      var ra = relOrder.indexOf(a.type), rb = relOrder.indexOf(b.type);
      if (ra !== rb) return ra - rb;
      return plainLabel(a.node.label).localeCompare(plainLabel(b.node.label));
    });

    drawEgo(node, neighbours);
    drawPanel(node, neighbours);
    setLegend(Array.from(new Set(neighbours.map(function (e) { return e.type; }))));
  }

  // ── SVG ego view ───────────────────────────────────────────────────────────
  function svgEl(tag, attrs) {
    var el = document.createElementNS(SVGNS, tag);
    for (var k in attrs) el.setAttribute(k, attrs[k]);
    return el;
  }
  function truncate(s, n) { return s.length > n ? s.slice(0, n - 1) + '…' : s; }

  function drawEgo(center, neighbours) {
    var W = 900, H = Math.max(560, 200 + neighbours.length * 14);
    var CX = W / 2, CY = H / 2;
    var N = neighbours.length;
    var rings = N <= 14 ? 1 : (N <= 30 ? 2 : 3);
    var baseR = Math.min(CX, CY) - 120;

    var svg = svgEl('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'group', 'aria-label': 'Connections of ' + plainLabel(center.label) });
    svg.setAttribute('class', 'gx-svg');

    var edgesG = svgEl('g', {}), nodesG = svgEl('g', {});
    svg.appendChild(edgesG); svg.appendChild(nodesG);

    neighbours.forEach(function (e, i) {
      var angle = (i / N) * 2 * Math.PI - Math.PI / 2;
      var r = baseR - (rings > 1 ? (i % rings) * 54 : 0);
      var x = CX + r * Math.cos(angle), y = CY + r * Math.sin(angle);

      edgesG.appendChild(svgEl('line', { x1: CX, y1: CY, x2: x, y2: y, stroke: REL_COLOURS[e.type] || '#999', 'stroke-width': 1.5, opacity: 0.55 }));

      var g = svgEl('g', { tabindex: 0, role: 'button', 'aria-label': plainLabel(e.node.label), 'data-id': e.node.id });
      g.setAttribute('class', 'gx-node');
      var c = svgEl('circle', { cx: x, cy: y, r: 7, fill: NODE_COLOURS[e.node.node_type] || '#888' });
      if (e.node.forthcoming) { c.setAttribute('stroke-dasharray', '2 2'); c.setAttribute('stroke', '#888'); c.setAttribute('fill-opacity', '0.45'); }
      g.appendChild(c);
      var onLeft = Math.cos(angle) < -0.08;
      var t = svgEl('text', {
        x: x + (onLeft ? -11 : 11), y: y + 4,
        'text-anchor': onLeft ? 'end' : (Math.abs(Math.cos(angle)) <= 0.08 ? 'middle' : 'start')
      });
      if (Math.abs(Math.cos(angle)) <= 0.08) t.setAttribute('y', y + (Math.sin(angle) < 0 ? -12 : 20));
      t.textContent = truncate(plainLabel(e.node.label), 26);
      var full = svgEl('title', {}); full.textContent = plainLabel(e.node.label);
      g.appendChild(full); g.appendChild(t);
      nodesG.appendChild(g);
    });

    // Centre node on top.
    var cg = svgEl('g', {});
    cg.setAttribute('class', 'gx-center');
    cg.appendChild(svgEl('circle', { cx: CX, cy: CY, r: 13, fill: NODE_COLOURS[center.node_type] || '#888', stroke: '#fff', 'stroke-width': 2.5 }));
    var ct = svgEl('text', { x: CX, y: CY + 32, 'text-anchor': 'middle' });
    ct.setAttribute('class', 'gx-center-label');
    ct.textContent = truncate(plainLabel(center.label), 34);
    cg.appendChild(ct);
    nodesG.appendChild(cg);

    stage.innerHTML = '';
    if (!N) {
      stage.innerHTML = '<p class="gx-empty">“' + esc(plainLabel(center.label)) + '” has no recorded connections yet.</p>';
      return;
    }
    stage.appendChild(svg);
  }

  // ── Side panel ─────────────────────────────────────────────────────────────
  function drawPanel(node, neighbours) {
    var colour = NODE_COLOURS[node.node_type] || '#888';
    var html = '<span class="gx-type-chip" style="background:' + colour + '">' + esc(TYPE_LABELS[node.node_type] || node.node_type) + (node.forthcoming ? ' · forthcoming' : '') + '</span>' +
      '<h2 class="gx-panel-title">' + esc(plainLabel(node.label)) + '</h2>';
    if (node.summary) html += '<p class="gx-panel-sub">' + esc(plainLabel(node.summary)) + '</p>';
    if (node.url) html += '<p><a class="gx-open" href="' + esc(node.url) + '">Open the page &rarr;</a></p>';

    var groups = {};
    neighbours.forEach(function (e) {
      var lbl = (REL_LABELS[e.type] || [e.type, e.type])[e.centerIsSource ? 0 : 1];
      (groups[lbl] = groups[lbl] || { type: e.type, items: [] }).items.push(e.node);
    });
    Object.keys(groups).forEach(function (lbl) {
      var g = groups[lbl];
      html += '<h3 class="gx-rel-head"><span class="gx-swatch" style="background:' + (REL_COLOURS[g.type] || '#999') + '"></span>' + esc(lbl) + ' <span class="gx-degree">(' + g.items.length + ')</span></h3><ul class="gx-conn-list">';
      g.items.forEach(function (n) {
        html += '<li><button type="button" class="gx-conn" data-id="' + esc(n.id) + '"><span class="gx-dot" style="background:' + (NODE_COLOURS[n.node_type] || '#888') + '"></span>' + esc(plainLabel(n.label)) + '</button></li>';
      });
      html += '</ul>';
    });
    panel.innerHTML = html;
  }

  // ── Search ─────────────────────────────────────────────────────────────────
  function doSearch(q) {
    q = q.trim().toLowerCase();
    if (q.length < 2) { searchList.hidden = true; searchInput.setAttribute('aria-expanded', 'false'); return; }
    var hits = connected.filter(function (n) { return plainLabel(n.label).toLowerCase().indexOf(q) !== -1; })
      .sort(function (a, b) { return (adj[b.id] || []).length - (adj[a.id] || []).length; }).slice(0, 10);
    if (!hits.length) { searchList.innerHTML = '<li class="gx-search-empty">No connected idea matches.</li>'; }
    else {
      searchList.innerHTML = hits.map(function (n) {
        return '<li role="option"><button type="button" class="gx-conn" data-id="' + esc(n.id) + '"><span class="gx-dot" style="background:' + (NODE_COLOURS[n.node_type] || '#888') + '"></span>' + esc(plainLabel(n.label)) + ' <span class="gx-degree">' + esc(TYPE_LABELS[n.node_type] || '') + '</span></button></li>';
      }).join('');
    }
    searchList.hidden = false;
    searchInput.setAttribute('aria-expanded', 'true');
  }

  // ── Routing (hash) ─────────────────────────────────────────────────────────
  function go(id) { location.hash = id ? encodeURIComponent(id) : ''; }
  function route() {
    var id = decodeURIComponent((location.hash || '').replace(/^#/, ''));
    searchList.hidden = true; searchInput.value = '';
    if (id && nodesById[id]) showFocus(id); else showOverview();
  }

  // Delegated clicks: any element with data-id navigates.
  document.addEventListener('click', function (ev) {
    var el = ev.target.closest ? ev.target.closest('[data-id]') : null;
    if (el) { go(el.getAttribute('data-id')); return; }
    if (!searchList.hidden && !ev.target.closest('.gx-searchwrap')) { searchList.hidden = true; }
  });
  stage.addEventListener('keydown', function (ev) {
    if ((ev.key === 'Enter' || ev.key === ' ') && ev.target.closest) {
      var el = ev.target.closest('.gx-node[data-id]');
      if (el) { ev.preventDefault(); go(el.getAttribute('data-id')); }
    }
  });
  overviewBtn.addEventListener('click', function () { go(''); });
  backBtn.addEventListener('click', function () { history.back(); });
  searchInput.addEventListener('input', function () { doSearch(searchInput.value); });
  window.addEventListener('hashchange', route);

  // ── Load data ──────────────────────────────────────────────────────────────
  fetch((window.__BASE__ || '/') + 'api/graph.json')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      data.nodes.forEach(function (n) { nodesById[n.id] = n; });
      data.edges.forEach(function (e) {
        if (!nodesById[e.source] || !nodesById[e.target]) return;
        (adj[e.source] = adj[e.source] || []).push({ id: e.target, type: e.type, centerIsSource: true });
        (adj[e.target] = adj[e.target] || []).push({ id: e.source, type: e.type, centerIsSource: false });
      });
      connected = data.nodes.filter(function (n) { return (adj[n.id] || []).length; });
      topics = data.nodes.filter(function (n) { return n.node_type === 'topic' && n.url; });
      if (loading) loading.remove();
      route();
    })
    .catch(function () {
      stage.innerHTML = '<p class="gx-empty">Could not load the connection data. Please try again.</p>';
    });
})();
</script>

<!-- is:global because the view DOM is built at runtime via innerHTML/SVG and
     doesn't carry Astro's scoped-style attribute. Namespaced under .graph-page. -->
<style is:global>
  .graph-page { padding: 1.5rem 1rem 3rem; max-width: 1300px; margin: 0 auto; }
  .graph-page .gx-header h1 { margin: 0 0 0.3rem; }
  .graph-page .gx-lede { color: var(--color-muted); max-width: 70ch; margin: 0 0 1rem; }

  .graph-page .gx-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .graph-page .gx-btn {
    font: inherit; font-size: 0.88rem; cursor: pointer; padding: 0.35rem 0.9rem;
    border: 1px solid var(--color-border); border-radius: 0.4rem;
    background: var(--color-surface); color: var(--color-primary);
  }
  .graph-page .gx-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .graph-page .gx-searchwrap { position: relative; flex: 1 1 16rem; max-width: 26rem; }
  .graph-page #gx-search {
    width: 100%; box-sizing: border-box; font: inherit; font-size: 0.9rem;
    padding: 0.4rem 0.7rem; border: 1px solid var(--color-border); border-radius: 0.4rem;
    background: var(--color-bg); color: inherit;
  }
  .graph-page .gx-search-list {
    position: absolute; z-index: 30; top: calc(100% + 4px); left: 0; right: 0;
    margin: 0; padding: 0.25rem; list-style: none;
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 0.4rem; box-shadow: 0 8px 24px rgba(0,0,0,0.15); max-height: 310px; overflow-y: auto;
  }
  .graph-page .gx-search-empty { padding: 0.5rem; color: var(--color-muted); font-size: 0.85rem; }

  .graph-page .gx-rel-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; list-style: none; margin: 0; padding: 0; font-size: 0.75rem; color: var(--color-muted); }
  .graph-page .gx-swatch { display: inline-block; width: 0.85em; height: 0.85em; border-radius: 2px; margin-right: 0.35em; vertical-align: -0.08em; }

  .graph-page .gx-stage-wrap { display: flex; gap: 1.25rem; align-items: flex-start; }
  .graph-page .gx-stage { flex: 1 1 60%; min-width: 0; }
  .graph-page .gx-panel {
    flex: 0 0 21rem; max-width: 21rem; position: sticky; top: calc(var(--header-h) + 1rem);
    max-height: calc(100vh - var(--header-h) - 2rem); overflow-y: auto;
    border: 1px solid var(--color-border); border-radius: 0.5rem; padding: 1rem;
    background: var(--color-bg);
  }
  @media (max-width: 900px) {
    .graph-page .gx-stage-wrap { flex-direction: column; }
    .graph-page .gx-panel { position: static; max-width: none; flex: 1 1 auto; max-height: none; width: 100%; box-sizing: border-box; }
  }

  .graph-page .gx-loading, .graph-page .gx-empty { color: var(--color-muted); font-style: italic; }

  /* Overview */
  .graph-page .gx-ov-hint { color: var(--color-muted); font-size: 0.9rem; margin: 0 0 1rem; }
  .graph-page .gx-ov-group { margin-bottom: 1.1rem; }
  .graph-page .gx-ov-group h2 { font-size: 1rem; color: var(--color-accent); margin: 0 0 0.45rem; }
  .graph-page .gx-ov-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .graph-page .gx-chip {
    font: inherit; font-size: 0.84rem; cursor: pointer; padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-border); border-radius: 999px;
    background: var(--color-surface); color: var(--color-primary);
  }
  .graph-page .gx-chip:hover, .graph-page .gx-chip:focus-visible { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }

  /* Ego SVG */
  .graph-page .gx-svg { width: 100%; height: auto; }
  .graph-page .gx-svg text { font-family: var(--font-serif, Georgia, serif); font-size: 12.5px; fill: var(--color-primary); }
  .graph-page .gx-node { cursor: pointer; }
  .graph-page .gx-node:hover circle, .graph-page .gx-node:focus-visible circle { stroke: var(--color-accent); stroke-width: 3; }
  .graph-page .gx-node:hover text { fill: var(--color-accent); }
  .graph-page .gx-node:focus-visible { outline: none; }
  .graph-page .gx-center-label { font-weight: 700; font-size: 14.5px; }

  /* Panel */
  .graph-page .gx-type-chip { display: inline-block; color: #fff; font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.15rem 0.55rem; border-radius: 999px; margin-bottom: 0.5rem; }
  .graph-page .gx-panel-title { font-size: 1.15rem; margin: 0 0 0.4rem; color: var(--color-primary); }
  .graph-page .gx-panel-sub { font-size: 0.88rem; color: var(--color-muted); margin: 0 0 0.6rem; }
  .graph-page .gx-open { font-weight: 600; }
  .graph-page .gx-rel-head { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-muted); margin: 1rem 0 0.3rem; }
  .graph-page .gx-conn-list { list-style: none; margin: 0; padding: 0; }
  .graph-page .gx-conn-list li { margin: 0; }
  .graph-page .gx-conn {
    display: flex; align-items: baseline; gap: 0.45rem; width: 100%; text-align: left;
    font: inherit; font-size: 0.9rem; cursor: pointer; padding: 0.28rem 0.3rem;
    border: none; background: none; color: var(--color-primary); border-radius: 0.3rem;
  }
  .graph-page .gx-conn:hover, .graph-page .gx-conn:focus-visible { background: var(--color-surface); color: var(--color-accent); }
  .graph-page .gx-dot { flex-shrink: 0; width: 0.6rem; height: 0.6rem; border-radius: 50%; align-self: center; }
  .graph-page .gx-degree { font-size: 0.74rem; color: var(--color-muted); }
</style>
