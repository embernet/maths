---
/**
 * TopicLayout.astro
 * Renders a topic page: prose content + sidebar (desktop) + quiz island.
 */
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Quiz from '../components/Quiz.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

interface SuggestedPreReading {
  kind: string;
  ref: string;
  why: string;
}

interface Props {
  frontmatter: {
    title: string;
    section?: string;
    section_slug?: string;
    year?: number;
    tags?: string[];
    prerequisites?: string[];
    related?: string[];
    mathematicians?: string[];
    reading_time_min?: number;
    summary?: string;
    node_type?: string;
    suggested_pre_reading?: SuggestedPreReading[];
  };
  /** Absolute path to the MDX file being rendered (passed by Astro content machinery) */
  file?: string;
}

const { frontmatter, file } = Astro.props;

// Attempt to load a colocated quiz.json
let quizData: unknown = null;
if (file) {
  const quizPath = join(dirname(file), 'quiz.json');
  if (existsSync(quizPath)) {
    try {
      quizData = JSON.parse(readFileSync(quizPath, 'utf8'));
    } catch {
      // Malformed quiz.json — skip silently.
    }
  }
}

// Load search index once to resolve pre-reading entry titles
const indexPath = join(process.cwd(), 'public', 'api', 'index.json');
let searchIndex: Array<{ url: string; title: string; slug: string }> = [];
if (existsSync(indexPath)) {
  try {
    searchIndex = JSON.parse(readFileSync(indexPath, 'utf8'));
  } catch {
    // Index not yet built — fall back to slug-derived labels.
  }
}

function resolvePreReadingHref(kind: string, ref: string): string {
  switch (kind) {
    case 'topic':        return `/${ref}`;
    case 'theorem':      return `/theorems/${ref}`;
    case 'application':  return `/applications/${ref}`;
    case 'mathematician': return `/mathematicians/${ref}`;
    case 'history':      return `/90-history/${ref}`;
    case 'definition':   return `/definitions/${ref}`;
    case 'nature':       return `/97-nature/${ref}`;
    default:             return `/${ref}`;
  }
}

function resolvePreReadingTitle(kind: string, ref: string): string {
  const href = resolvePreReadingHref(kind, ref);
  const entry = searchIndex.find(r => r.url === href);
  if (entry) return entry.title;
  // Fall back: humanise the final path segment
  const last = ref.split('/').pop() ?? ref;
  return last.replace(/^\d+-/, '').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

const preReading = frontmatter.suggested_pre_reading ?? [];
---

<BaseLayout title={frontmatter.title} description={frontmatter.summary}>
  <div class="topic-page-wrapper">
    <!-- Main prose content -->
    <article class="prose-content topic-article" aria-label={frontmatter.title}>
      <header class="topic-header">
        {frontmatter.section && (
          <span class="section-badge">{frontmatter.section}</span>
        )}
        <h1>{frontmatter.title}</h1>
        <div class="topic-meta">
          {frontmatter.reading_time_min && (
            <span class="reading-chip">⏱ {frontmatter.reading_time_min} min read</span>
          )}
          {frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="tag-list" aria-label="Tags">
              {frontmatter.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
          )}
        </div>
        {frontmatter.prerequisites && frontmatter.prerequisites.length > 0 && (
          <p class="prereq-note">
            <strong>Prerequisites:</strong>{' '}
            {frontmatter.prerequisites.map((slug, i) => (
              <>
                <a href={`/${frontmatter.section_slug}/${slug}`}>{slug}</a>
                {i < (frontmatter.prerequisites?.length ?? 0) - 1 ? ', ' : ''}
              </>
            ))}
          </p>
        )}
      </header>

      {preReading.length > 0 && (
        <section class="suggested-pre-reading" aria-label="Suggested pre-reading">
          <h2>Suggested pre-reading</h2>
          <ul>
            {preReading.map((entry) => (
              <li>
                <a href={resolvePreReadingHref(entry.kind, entry.ref)}>
                  {resolvePreReadingTitle(entry.kind, entry.ref)}
                </a>
                {' '}&mdash;{' '}
                <em>{entry.why}</em>
              </li>
            ))}
          </ul>
        </section>
      )}

      <slot />

      {quizData && (
        <section class="quiz-island no-print" aria-label="Check your understanding">
          <Quiz quizData={quizData} />
        </section>
      )}
    </article>

    <!-- Sidebar: related topics + linked mathematicians (in-content on mobile, fixed on desktop) -->
    <Sidebar
      related={frontmatter.related}
      mathematicians={frontmatter.mathematicians}
      sectionSlug={frontmatter.section_slug}
    />
  </div>
</BaseLayout>

<style>
  .topic-page-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .topic-page-wrapper {
      flex-direction: row;
      align-items: flex-start;
      padding: 0 2rem;
    }
    .topic-article {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  .topic-header { margin-bottom: 1.5rem; }

  .topic-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .prereq-note {
    font-size: 0.9rem;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 0.5rem 0.85rem;
    margin-top: 0.75rem;
  }

  .suggested-pre-reading {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 0.45rem 0.45rem 0;
    padding: 0.9rem 1.1rem;
    margin: 1.25rem 0 1.75rem;
  }

  .suggested-pre-reading h2 {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 0.6rem;
  }

  .suggested-pre-reading ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .suggested-pre-reading li {
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .suggested-pre-reading a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .suggested-pre-reading a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .suggested-pre-reading em {
    color: var(--color-muted);
    font-style: italic;
  }

  .quiz-island {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
