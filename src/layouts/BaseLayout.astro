---
/**
 * BaseLayout.astro
 * Wraps every page: sticky header, KaTeX CSS, print sheet, footer.
 * At ≥1024px: left sidebar + main content.
 * At ≥1280px: left sidebar + main content + right sidebar (if present).
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import Dialog from '../components/Dialog.astro';
import BookmarksStore from '../components/BookmarksStore.astro';
import HistoryStore from '../components/HistoryStore.astro';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title: string;
  description?: string;
  /** Social-share image — root-relative (with base) or absolute URL. */
  image?: string;
  /** Open Graph type: 'website' for index pages, 'article' for content. */
  ogType?: 'website' | 'article';
  /** Set true to keep a page out of search indexes. */
  noindex?: boolean;
  /** Extra <head> content (e.g. canonical, og:image) */
  headSlot?: string;
}

const {
  title,
  description = 'Mathematics Companion — a map of mathematics, from foundations to advanced topics.',
  image,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const siteTitle = 'Mathematics Companion';
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;

// ── SEO: canonical + social URLs ────────────────────────────────────────────
// Normalised base WITH a trailing slash. import.meta.env.BASE_URL is "/maths"
// (no trailing slash) for this config, so append one to make string
// concatenation (base + "sitemap.xml" etc.) reliable.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`; // "/maths/"
// Pages are served with a trailing slash (non-slash paths 307-redirect), so the
// canonical URL uses the trailing-slash form.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// Origin for absolute canonical/OG URLs. Inlined (rather than Astro.site, which
// we deliberately don't set — see astro.config.mjs). Keep in sync with
// SITE_ORIGIN in src/lib/site-config.mjs.
const siteOrigin = new URL('https://tapestrylab.net');
const canonicalURL = new URL(path, siteOrigin).href;
const ogImageURL = new URL(image ?? `${base}og-image.png`, siteOrigin).href;
const siteHomeURL = new URL(base, siteOrigin).href;

// ── SEO: breadcrumb trail from the URL path ─────────────────────────────────
function prettify(seg: string): string {
  return seg
    .replace(/^\d+[-.]?/, '')           // drop numeric ordering prefixes (01-foundations)
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .trim();
}
const relSegments = path.slice(base.length).split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'Home', item: siteHomeURL },
  ...relSegments.map((seg, i) => ({
    name: prettify(seg),
    item: new URL(`${base}${relSegments.slice(0, i + 1).join('/')}/`, siteOrigin).href,
  })),
];

// ── SEO: JSON-LD structured data ────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteHomeURL}#website`,
      url: siteHomeURL,
      name: siteTitle,
      description: 'A map of mathematics, from foundations to advanced topics.',
      inLanguage: 'en-GB',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${siteHomeURL}#website` },
      inLanguage: 'en-GB',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: b.item,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- SEO: canonical + indexing -->
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Deployment base path (served under a sub-path). Exposed for inline
         client scripts, which Vite does not process (so import.meta.env is
         unavailable there). import.meta.env.BASE_URL is e.g. "/maths/". -->
    <script define:vars={{ base }} is:inline>
      window.__BASE__ = base;
      // Apply the persisted sidebar width BEFORE first paint, so navigation
      // doesn't flash the default width and then jump (key + clamp kept in
      // sync with the resizer in LeftSidebar.astro).
      try {
        var sbw = parseInt(localStorage.getItem('mc-sidebar-width') || '', 10);
        if (sbw) document.documentElement.style.setProperty('--sidebar-w', Math.max(160, Math.min(480, sbw)) + 'px');
      } catch (e) {}
    </script>

    <!-- Shared client APIs (window.mcBookmarks + window.mcUtil, then
         window.mcHistory which uses mcUtil), defined before the header/page
         scripts that use them. HistoryStore also records this visit. -->
    <BookmarksStore />
    <HistoryStore />

    <!--
      KaTeX MathML hide rule (defence-in-depth).
      KaTeX renders BOTH a .katex-mathml span (for screen readers) AND a
      .katex-html span (visible glyphs). The bundled KaTeX stylesheet hides
      the MathML one, but if that stylesheet ever fails to load — wrong
      bundle, stale service-worker cache, dev-server quirk — both render
      visibly and you see doubled output like "f:A→B  f:A→B".
      This inline rule is a hard backstop that runs regardless of any
      bundling, scoping, or import-resolution issue downstream.
    -->
    <style is:inline>
      .katex-mathml {
        position: absolute !important;
        clip: rect(1px, 1px, 1px, 1px) !important;
        clip-path: inset(50%) !important;
        height: 1px !important;
        width: 1px !important;
        overflow: hidden !important;
        padding: 0 !important;
        border: 0 !important;
      }
    </style>

    <!-- PWA manifest + theming -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a3a52" />

    <!-- Browser-tab favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />

    <!-- Home-screen / installed-app icon (iOS + Android) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />

    <!-- Standalone app behaviour (app-like top bar, no browser chrome) -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Maths Companion" />

    <!-- Print stylesheet is injected by global.css @media print block -->

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <div class="page-body">
      <LeftSidebar currentPath={Astro.url.pathname} />
      <main id="main-content" class="main-content">
        <slot />
      </main>
    </div>
    <Footer />
    <Dialog />

    <!-- Service worker registration -->
    <script>
      if ('serviceWorker' in navigator) {
        // When an updated service worker takes control (skipWaiting + claim),
        // reload once so the page immediately reflects the new version instead
        // of showing content served by the previous worker. Guarded so it can
        // never loop, and skipped on the very first install (controller was null).
        var hadController = !!navigator.serviceWorker.controller;
        var reloaded = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!hadController || reloaded) return;
          reloaded = true;
          window.location.reload();
        });
        window.addEventListener('load', () => {
          var base = window.__BASE__ || '/';
          navigator.serviceWorker.register(base + 'sw.js', { scope: base })
            .then((reg) => { if (reg && reg.update) reg.update(); }) // check for a new worker right away
            .catch(() => {
              // SW registration failed — silently degrade.
            });
        });
      }
    </script>
  </body>
</html>

<style>
  /* Page body: sidebar + main layout */
  .page-body {
    display: flex;
    min-height: calc(100vh - var(--header-h));
    padding-top: var(--header-h);
    align-items: flex-start;
  }

  .main-content {
    flex: 1 1 0;
    min-width: 0;
  }

  /* Override global body > main padding-top since .page-body handles it */
  body > .page-body > main {
    padding-top: 0;
  }
</style>
